<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <Identity Name="Yursic.Studio" Publisher="CN=Yursic" Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="D087F850-FCBB-42B9-A325-19B99D4FEB22" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Yursic Studio</DisplayName>
    <PublisherDisplayName>Yursic</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="Yursic.App">
      <uap:VisualElements
        DisplayName="Yursic Studio"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Multitrack music studio for Xbox with USB plugins and storage."
        BackgroundColor="#14141A">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Yursic"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#14141A"/>
      </uap:VisualElements>

      <!-- UWP apps only see files on USB drives whose types are declared here. -->
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="yursicaudio">
            <uap:DisplayName>Audio</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.wav</uap:FileType>
              <uap:FileType>.mp3</uap:FileType>
              <uap:FileType>.m4a</uap:FileType>
              <uap:FileType>.wma</uap:FileType>
              <uap:FileType>.flac</uap:FileType>
              <uap:FileType>.aac</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="yursicplugin">
            <uap:DisplayName>Yursic Plugin</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.yplug</uap:FileType>
              <uap:FileType>.zip</uap:FileType>
              <uap:FileType>.json</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="yursicproject">
            <uap:DisplayName>Yursic Project</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.yproj</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <uap:Capability Name="removableStorage" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
