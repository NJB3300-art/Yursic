<Page
    x:Class="Yursic.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="DriveTemplate">
            <Grid Width="360" Padding="18" CornerRadius="12" Background="{StaticResource YSurface2}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE88E;" FontSize="26" Foreground="{StaticResource YAccent2}" />
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ProgressBar Value="{Binding UsedPercent}" Maximum="100" Height="8" CornerRadius="4" />
                    <TextBlock Text="{Binding SpaceText}" Foreground="{StaticResource YTextDim}" FontSize="13" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
            <Grid>
                <TextBlock Text="USB Storage" Style="{StaticResource PageTitle}" />
                <Button x:Name="RefreshButton" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource PillButton}" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Drives -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Drives" Style="{StaticResource SectionTitle}" />
                    <GridView x:Name="DrivesList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Drive_ItemClick"
                              ItemTemplate="{StaticResource DriveTemplate}" />
                    <TextBlock x:Name="NoDrives" Style="{StaticResource DimText}" Visibility="Collapsed"
                               Text="No USB drive found. Plug one in (NTFS or exFAT recommended). This page updates automatically." />
                    <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0" FontSize="12"
                               Text="Choose a drive to browse it. Yursic keeps its files in a Yursic folder: Plugins, Projects, Samples and Exports." />
                </StackPanel>
            </Border>

            <!-- Browser -->
            <Border x:Name="BrowserCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="UpButton" Click="Up_Click" Padding="12,6" ToolTipService.ToolTip="Up one folder">
                                <FontIcon Glyph="&#xE74A;" FontSize="16" />
                            </Button>
                            <TextBlock x:Name="PathText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PillButton}" Click="Prepare_Click" Content="Create Yursic folders" />
                            <Button Style="{StaticResource PillButton}" Click="NewFolder_Click" Content="New folder" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="BrowserStatus" Style="{StaticResource DimText}" Margin="0,0,0,8" />
                    <ListView x:Name="EntriesList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Entry_ItemClick"
                              ItemTemplate="{StaticResource EntryTemplate}" MaxHeight="520" />
                    <TextBlock x:Name="EmptyFolder" Style="{StaticResource DimText}" Text="This folder is empty (Yursic only sees audio, plugin and project files)." Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Console storage -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <TextBlock Text="On this console" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Projects" VerticalAlignment="Center" FontSize="16" />
                        <TextBlock x:Name="ProjectsSize" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource YTextDim}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource PillButton}" Click="BackupProjects_Click" Content="Back up all to USB" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Plugins" VerticalAlignment="Center" FontSize="16" />
                        <TextBlock x:Name="PluginsSize" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource YTextDim}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource DimText}" Text="Manage on the Plugins page." />

                        <TextBlock Grid.Row="2" Text="Exports" VerticalAlignment="Center" FontSize="16" />
                        <TextBlock x:Name="ExportsSize" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource YTextDim}" />
                        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource PillButton}" Click="CopyExports_Click" Content="Copy all to USB" />
                            <Button Style="{StaticResource PillButton}" Click="ClearExports_Click" Content="Delete all" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="LocalStatus" Style="{StaticResource DimText}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
