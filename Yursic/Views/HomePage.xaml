<Page
    x:Class="Yursic.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Yursic.Models"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Your projects" Style="{StaticResource PageTitle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Button x:Name="NewButton" Style="{StaticResource AccentPillButton}" Click="New_Click" XYFocusDown="{x:Bind ProjectsGrid}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE710;" FontSize="16" />
                    <TextBlock Text="New project" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource PillButton}" Click="Import_Click">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE88E;" FontSize="16" />
                    <TextBlock Text="Open from USB" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="16,0" Style="{StaticResource DimText}" />
        </StackPanel>

        <GridView x:Name="ProjectsGrid" Grid.Row="2"
                  IsItemClickEnabled="True"
                  ItemClick="Grid_ItemClick"
                  SelectionMode="None"
                  Padding="0,0,0,40">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:ProjectSummary">
                    <Grid Width="280" Height="220" CornerRadius="12" Background="{StaticResource YSurface}">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Open" Icon="OpenFile" Click="Open_Click" Tag="{x:Bind Id}" />
                                <MenuFlyoutItem Text="Rename" Icon="Rename" Click="Rename_Click" Tag="{x:Bind Id}" />
                                <MenuFlyoutItem Text="Copy to USB" Icon="Upload" Click="Export_Click" Tag="{x:Bind Id}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Delete" Icon="Delete" Click="Delete_Click" Tag="{x:Bind Id}" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid CornerRadius="12,12,0,0">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C5CFF" Offset="0" />
                                    <GradientStop Color="#00D4AA" Offset="1" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <FontIcon Glyph="&#xE8D6;" FontSize="48" Opacity="0.85" />
                        </Grid>
                        <StackPanel Grid.Row="1" Padding="16,12">
                            <TextBlock Text="{x:Bind Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource DimText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel x:Name="Empty" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Spacing="8">
            <FontIcon Glyph="&#xE8D6;" FontSize="56" Foreground="{StaticResource YTextDim}" />
            <TextBlock Text="No projects yet" FontSize="22" HorizontalAlignment="Center" />
            <TextBlock Text="Start a new one, or open a .yproj from a USB drive." Style="{StaticResource DimText}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
