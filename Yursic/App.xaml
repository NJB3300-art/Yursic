<Application
    x:Class="Yursic.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette -->
            <Color x:Key="YAccentColor">#7C5CFF</Color>
            <Color x:Key="YAccent2Color">#00D4AA</Color>
            <Color x:Key="YRecordColor">#FF3B5C</Color>
            <Color x:Key="YBgColor">#14141A</Color>
            <Color x:Key="YSurfaceColor">#1E1E26</Color>
            <Color x:Key="YSurface2Color">#272731</Color>
            <Color x:Key="YLineColor">#33333F</Color>
            <Color x:Key="YTextDimColor">#9A9AAE</Color>

            <SolidColorBrush x:Key="YAccent" Color="{StaticResource YAccentColor}" />
            <SolidColorBrush x:Key="YAccent2" Color="{StaticResource YAccent2Color}" />
            <SolidColorBrush x:Key="YRecord" Color="{StaticResource YRecordColor}" />
            <SolidColorBrush x:Key="YBg" Color="{StaticResource YBgColor}" />
            <SolidColorBrush x:Key="YSurface" Color="{StaticResource YSurfaceColor}" />
            <SolidColorBrush x:Key="YSurface2" Color="{StaticResource YSurface2Color}" />
            <SolidColorBrush x:Key="YLine" Color="{StaticResource YLineColor}" />
            <SolidColorBrush x:Key="YTextDim" Color="{StaticResource YTextDimColor}" />

            <!-- Override system accent so built-in controls (sliders, toggles, focus) match. -->
            <Color x:Key="SystemAccentColor">#7C5CFF</Color>
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#7C5CFF" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#9278FF" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#6A48F0" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />

            <Style x:Key="TransportButton" TargetType="Button">
                <Setter Property="Width" Value="52" />
                <Setter Property="Height" Value="52" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="Background" Value="{StaticResource YSurface2}" />
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="PillButton" TargetType="Button">
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="20,0" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Background" Value="{StaticResource YSurface2}" />
                <Setter Property="FontSize" Value="16" />
            </Style>

            <Style x:Key="AccentPillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
                <Setter Property="Background" Value="{StaticResource YAccent}" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="SmallToggle" TargetType="ToggleButton">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Pill tabs (Mixer / Effects / Sounds) -->
            <Style x:Key="TabRadio" TargetType="RadioButton">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="18" Padding="18,7">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Text.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Text.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Bd.Background" Value="{StaticResource YAccent}" />
                                                <Setter Target="Text.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="Text" Content="{TemplateBinding Content}" Opacity="0.75" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource YSurface}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="34" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <!-- Row for files/folders/plugins (StorageEntry). Used by lists and pick dialogs. -->
            <DataTemplate x:Key="EntryTemplate">
                <Grid Padding="4,8" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{Binding Glyph}" FontSize="22" Foreground="{StaticResource YAccent}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontSize="16" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource YTextDim}" FontSize="13" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <Style x:Key="DimText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource YTextDim}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
